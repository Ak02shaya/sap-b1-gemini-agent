{"timestamp": "2026-09-28T03:36:58.515207", "query": "SELECT TOP 25 YEAR(T0.\"DocDate\") AS \"Year\", MONTH(T0.\"DocDate\") AS \"Month\", COUNT(DISTINCT T0.\"DocNum\") AS \"Invoice Count\", SUM(T1.\"Quantity\") AS \"Total Qty\", SUM(T1.\"LineTotal\") AS \"Total Sales\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" T4 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T4.\"WhsCode\" WHERE T0.\"DocDate\" >= ADD_MONTHS((SELECT MAX(\"DocDate\") FROM \"OINV\"), -6) AND T0.\"CANCELED\" = 'N' AND LOWER(T3.\"ItmsGrpNam\") = LOWER('Samsung Panel') AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' GROUP BY YEAR(T0.\"DocDate\"), MONTH(T0.\"DocDate\") ORDER BY \"Year\" ASC, \"Month\" ASC", "status": "SUCCESS", "details": ""}
