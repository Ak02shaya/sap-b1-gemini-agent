{"timestamp": "2026-09-26T12:31:05.521941", "query": "SELECT TOP 5 T0.\"DocEntry\", T0.\"DocDate\", T0.\"U_ReqWhs\", T1.\"ItemCode\", T2.\"ItmsGrpCod\", T3.\"ItmsGrpNam\", T2.\"FirmCode\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"DocDate\" >= '2025-03-01' AND T0.\"DocDate\" <= '2025-03-31'", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-26T12:31:13.851959", "query": "SELECT TOP 25 \"Category\", \"Brand\", \"Total Sales\", \"Total Quantity\", \"Sales Rank\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"Category\", IFNULL(T4.\"FirmName\", 'Unassigned') AS \"Brand\", ROUND(SUM(T1.\"LineTotal\"), 2) AS \"Total Sales\", CAST(SUM(T1.\"Quantity\") AS INTEGER) AS \"Total Quantity\", RANK() OVER (PARTITION BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"Sales Rank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" LEFT JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" AND T2.\"FirmCode\" > 0 WHERE T0.\"DocDate\" >= '2025-03-01' AND T0.\"DocDate\" <= '2025-03-31' AND (T0.\"U_ReqWhs\" IS NULL OR T0.\"U_ReqWhs\" NOT LIKE 'CWH%') AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' GROUP BY T3.\"ItmsGrpNam\", T4.\"FirmName\" ) WHERE \"Sales Rank\" <= 3 ORDER BY \"Category\", \"Sales Rank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-26T12:31:22.081188", "query": "SELECT TOP 25 \"Category\", \"Brand\", \"Total Sales\", \"Total Quantity\", \"Sales Rank\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"Category\", IFNULL(T4.\"FirmName\", 'No Brand Assigned') AS \"Brand\", ROUND(SUM(T1.\"LineTotal\"), 2) AS \"Total Sales\", CAST(SUM(T1.\"Quantity\") AS INTEGER) AS \"Total Quantity\", RANK() OVER (PARTITION BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"Sales Rank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" LEFT JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" WHERE YEAR(T0.\"DocDate\") = (SELECT YEAR(MAX(\"DocDate\")) FROM \"OINV\") AND MONTH(T0.\"DocDate\") = (SELECT MONTH(MAX(\"DocDate\")) FROM \"OINV\") AND (T0.\"U_ReqWhs\" IS NULL OR T0.\"U_ReqWhs\" NOT LIKE 'CWH%') AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' GROUP BY T3.\"ItmsGrpNam\", T4.\"FirmName\" ) WHERE \"Sales Rank\" <= 3 ORDER BY \"Category\", \"Sales Rank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-26T12:31:29.783409", "query": "SELECT TOP 25 \"Category\", \"Brand\", \"Total Sales\", \"Total Quantity\", \"Sales Rank\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"Category\", IFNULL(T4.\"FirmName\", '- No Brand -') AS \"Brand\", ROUND(SUM(T1.\"LineTotal\"), 2) AS \"Total Sales\", CAST(SUM(T1.\"Quantity\") AS INTEGER) AS \"Total Quantity\", RANK() OVER (PARTITION BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"Sales Rank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" LEFT JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" WHERE YEAR(T0.\"DocDate\") = (SELECT YEAR(MAX(\"DocDate\")) FROM \"OINV\") AND (T0.\"U_ReqWhs\" IS NULL OR T0.\"U_ReqWhs\" NOT LIKE 'CWH%') AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' GROUP BY T3.\"ItmsGrpNam\", T4.\"FirmName\" ) WHERE \"Sales Rank\" <= 3 ORDER BY \"Total Sales\" DESC, \"Category\", \"Sales Rank\"", "status": "SUCCESS", "details": ""}
