{"timestamp": "2026-09-29T03:25:07.277343", "query": "SELECT TOP 25 T0.\"ItemCode\" AS \"Item Code\", T1.\"ItemName\" AS \"Item Name\", T3.\"ItmsGrpNam\" AS \"Category\", T0.\"WhsCode\" AS \"Warehouse Code\", T2.\"WhsName\" AS \"Warehouse Name\", T2.\"Location\" AS \"Location / State\", T0.\"OnHand\" AS \"Stock On Hand\", T0.\"IsCommited\" AS \"Committed Qty\", T0.\"OnOrder\" AS \"On Order Qty\", (T0.\"OnHand\" - T0.\"IsCommited\") AS \"Available Qty\", T1.\"MinLevel\" AS \"Min Stock Level\", T1.\"ReorderPnt\" AS \"Reorder Point\" FROM \"OITW\" T0 INNER JOIN \"OITM\" T1 ON T0.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OWHS\" T2 ON T0.\"WhsCode\" = T2.\"WhsCode\" INNER JOIN \"OITB\" T3 ON T1.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T1.\"InvntItem\" = 'Y' AND T1.\"Canceled\" = 'N' AND T0.\"OnHand\" > 0 AND T0.\"OnHand\" <= T1.\"MinLevel\" AND T1.\"MinLevel\" > 0 AND T2.\"WhsName\" NOT LIKE '%defect%' AND T2.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemName\" NOT LIKE '%Carry Bag%' ORDER BY \"Available Qty\" ASC, T0.\"OnHand\" ASC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:25:14.301492", "query": "SELECT TOP 25 T0.\"ItemCode\" AS \"Item Code\", T1.\"ItemName\" AS \"Item Name\", T3.\"ItmsGrpNam\" AS \"Category\", T0.\"WhsCode\" AS \"Warehouse Code\", T2.\"WhsName\" AS \"Warehouse Name\", T2.\"Location\" AS \"Location / State\", T0.\"OnHand\" AS \"Stock On Hand\", T0.\"IsCommited\" AS \"Committed Qty\", T0.\"OnOrder\" AS \"On Order Qty\", (T0.\"OnHand\" - T0.\"IsCommited\") AS \"Available Qty\", T1.\"MinLevel\" AS \"Min Stock Level\", T1.\"ReorderPnt\" AS \"Reorder Point\" FROM \"OITW\" T0 INNER JOIN \"OITM\" T1 ON T0.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OWHS\" T2 ON T0.\"WhsCode\" = T2.\"WhsCode\" INNER JOIN \"OITB\" T3 ON T1.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T1.\"InvntItem\" = 'Y' AND T1.\"Canceled\" = 'N' AND T0.\"OnHand\" > 0 AND T0.\"OnHand\" <= T1.\"ReorderPnt\" AND T1.\"ReorderPnt\" > 0 AND T2.\"WhsName\" NOT LIKE '%defect%' AND T2.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemName\" NOT LIKE '%Carry Bag%' ORDER BY \"Available Qty\" ASC, T0.\"OnHand\" ASC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:25:20.708056", "query": "SELECT TOP 25 T0.\"ItemCode\" AS \"Item Code\", T1.\"ItemName\" AS \"Item Name\", T3.\"ItmsGrpNam\" AS \"Category\", T0.\"WhsCode\" AS \"Warehouse Code\", T2.\"WhsName\" AS \"Warehouse Name\", T2.\"Location\" AS \"Location / State\", T0.\"OnHand\" AS \"Stock On Hand\", T0.\"IsCommited\" AS \"Committed Qty\", T0.\"OnOrder\" AS \"On Order Qty\", (T0.\"OnHand\" - T0.\"IsCommited\") AS \"Available Qty\", T1.\"MinLevel\" AS \"Min Stock Level\", T1.\"ReorderPnt\" AS \"Reorder Point\" FROM \"OITW\" T0 INNER JOIN \"OITM\" T1 ON T0.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OWHS\" T2 ON T0.\"WhsCode\" = T2.\"WhsCode\" INNER JOIN \"OITB\" T3 ON T1.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T1.\"InvntItem\" = 'Y' AND T1.\"Canceled\" = 'N' AND T0.\"OnHand\" BETWEEN 1 AND 5 AND T2.\"WhsName\" NOT LIKE '%defect%' AND T2.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemName\" NOT LIKE '%Carry Bag%' ORDER BY T0.\"OnHand\" ASC, \"Available Qty\" ASC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:28:25.373454", "query": "SELECT TOP 75 T5.\"Category\", T5.\"Brand\", T5.\"TotalRevenue\", T5.\"TotalQtySold\", T5.\"TotalInvoices\", T5.\"RankByRevenue\" FROM ( SELECT T4.\"Category\", T4.\"Brand\", T4.\"TotalRevenue\", T4.\"TotalQtySold\", T4.\"TotalInvoices\", RANK() OVER (PARTITION BY T4.\"Category\" ORDER BY T4.\"TotalRevenue\" DESC) AS \"RankByRevenue\" FROM ( SELECT CASE WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%FAN%' THEN 'FANS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' THEN 'REFRIGERATORS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WASHING MACHINE%' THEN 'WASHING MACHINES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AIR CONDITION%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%AC%' THEN 'AIR CONDITIONERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER HEATER%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%GEYSER%' THEN 'WATER HEATERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%CHIMNEY%' THEN 'CHIMNEYS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%HOB%' THEN 'HOBS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%COOKER%' THEN 'PRESSURE COOKERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MIXER%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%GRINDER%' THEN 'MIXERS & GRINDERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%IRON%' THEN 'IRONS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER PURIFIER%' THEN 'WATER PURIFIERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%TELEVISION%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%TV%' THEN 'TELEVISIONS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MICROWAVE%' THEN 'MICROWAVES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%VACUUM%' THEN 'VACUUM CLEANERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%KETTLE%' THEN 'KETTLES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%COOLER%' THEN 'AIR COOLERS' ELSE 'OTHER' END AS \"Category\", TRIM( CASE WHEN INSTR(UPPER(T3.\"ItmsGrpNam\"), ' ') > 0 THEN SUBSTR(T3.\"ItmsGrpNam\", 1, INSTR(T3.\"ItmsGrpNam\", ' ') - 1) ELSE T3.\"ItmsGrpNam\" END ) AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQtySold\", COUNT(DISTINCT T0.\"DocEntry\") AS \"TotalInvoices\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" T4 ON T1.\"WhsCode\" = T4.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' AND UPPER(T1.\"ItemCode\") NOT LIKE '%CARRY BAG%' AND UPPER(T3.\"ItmsGrpNam\") NOT LIKE '%DEFECT%' AND UPPER(T4.\"WhsName\") NOT LIKE '%DEFECT%' AND T0.\"DocType\" = 'I' GROUP BY CASE WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%FAN%' THEN 'FANS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' THEN 'REFRIGERATORS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WASHING MACHINE%' THEN 'WASHING MACHINES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AIR CONDITION%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%AC%' THEN 'AIR CONDITIONERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER HEATER%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%GEYSER%' THEN 'WATER HEATERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%CHIMNEY%' THEN 'CHIMNEYS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%HOB%' THEN 'HOBS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%COOKER%' THEN 'PRESSURE COOKERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MIXER%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%GRINDER%' THEN 'MIXERS & GRINDERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%IRON%' THEN 'IRONS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER PURIFIER%' THEN 'WATER PURIFIERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%TELEVISION%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%TV%' THEN 'TELEVISIONS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MICROWAVE%' THEN 'MICROWAVES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%VACUUM%' THEN 'VACUUM CLEANERS' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%KETTLE%' THEN 'KETTLES' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%COOLER%' THEN 'AIR COOLERS' ELSE 'OTHER' END, TRIM( CASE WHEN INSTR(UPPER(T3.\"ItmsGrpNam\"), ' ') > 0 THEN SUBSTR(T3.\"ItmsGrpNam\", 1, INSTR(T3.\"ItmsGrpNam\", ' ') - 1) ELSE T3.\"ItmsGrpNam\" END ) ) T4 ) T5 WHERE T5.\"RankByRevenue\" <= 3 AND T5.\"Category\" != 'OTHER' ORDER BY T5.\"Category\", T5.\"RankByRevenue\"", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
