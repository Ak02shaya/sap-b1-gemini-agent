{"timestamp": "2026-09-28T06:29:14.359088", "query": "SELECT TOP 25 T3.\"WhsName\" AS \"Branch\", IFNULL(NULLIF(T3.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OWHS\" T3 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T3.\"WhsCode\" INNER JOIN \"OITB\" T4 ON T2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T3.\"WhsName\" NOT LIKE '%CWH%' AND T3.\"WhsName\" NOT LIKE '%Defective%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' GROUP BY T3.\"WhsName\", T3.\"U_Location\" ORDER BY (SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END)) DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:29:27.993681", "query": "SELECT TOP 25 SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\", COUNT(DISTINCT CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T0.\"DocEntry\" END) AS \"Diwali_2023_Orders\", COUNT(DISTINCT CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T0.\"DocEntry\" END) AS \"Diwali_2024_Orders\", COUNT(DISTINCT CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T0.\"DocEntry\" END) AS \"Pongal_2024_Orders\", COUNT(DISTINCT CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T0.\"DocEntry\" END) AS \"Pongal_2025_Orders\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%'", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T07:15:53.271483", "query": "SELECT TOP 25 IFNULL(NULLIF(T2.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OWHS\" T2 ON T1.\"WhsCode\" = T2.\"WhsCode\" INNER JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T3.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" NOT LIKE 'CWH%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T1.\"ItemCode\" NOT LIKE '%Carry Bag%' AND T0.\"DocDate\" BETWEEN '2023-11-05' AND '2025-01-21' GROUP BY T2.\"U_Location\" ORDER BY (\"Diwali_2023\" + \"Diwali_2024\" + \"Pongal_2024\" + \"Pongal_2025\") DESC", "status": "SUCCESS", "details": ""}
