{"timestamp": "2026-09-28T07:31:38.316030", "query": "SELECT TOP 25 CASE WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%MOBILE%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%MOB-%' THEN 'Mobile Phones' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%PANEL%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%TV%' THEN 'Television / Panels' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '% REF%' THEN 'Refrigerators' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%LAP TOP%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%LAPTOP%' THEN 'Laptops' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%WM%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%WASH%' THEN 'Washing Machines' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%AIR COND%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%AC%' THEN 'Air Conditioners' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%WATER HEAT%' THEN 'Water Heaters' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%AUDIO%' THEN 'Audio' ELSE 'Others' END AS \"ProductCategory\", T4.\"ItmsGrpNam\" AS \"BrandCategory\", SUM(T1.\"LineTotal\") AS \"TotalSales\", SUM(T1.\"Quantity\") AS \"TotalQty\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" NOT LIKE 'CWH%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Others%' GROUP BY CASE WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%MOBILE%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%MOB-%' THEN 'Mobile Phones' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%PANEL%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%TV%' THEN 'Television / Panels' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '% REF%' THEN 'Refrigerators' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%LAP TOP%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%LAPTOP%' THEN 'Laptops' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%WM%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%WASH%' THEN 'Washing Machines' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%AIR COND%' OR UPPER(T4.\"ItmsGrpNam\") LIKE '%AC%' THEN 'Air Conditioners' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%WATER HEAT%' THEN 'Water Heaters' WHEN UPPER(T4.\"ItmsGrpNam\") LIKE '%AUDIO%' THEN 'Audio' ELSE 'Others' END, T4.\"ItmsGrpNam\" ORDER BY \"ProductCategory\", SUM(T1.\"LineTotal\") DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-28T07:35:40.822077", "query": "SELECT TOP 25 T4.\"ItmsGrpNam\" AS \"Category\", T5.\"FirmName\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalSales\", SUM(T1.\"Quantity\") AS \"TotalQty\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" INNER JOIN \"OMRC\" T5 ON T2.\"FirmCode\" = T5.\"FirmCode\" INNER JOIN \"OWHS\" T3 ON T1.\"WhsCode\" = T3.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" NOT LIKE 'CWH%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' GROUP BY T4.\"ItmsGrpNam\", T5.\"FirmName\" ORDER BY T4.\"ItmsGrpNam\", \"TotalSales\" DESC", "status": "SUCCESS", "details": ""}
