{"timestamp": "2026-09-28T05:46:06.053831", "query": "SELECT TOP 25 CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-10' AND '2024-01-20' THEN 'Pongal 2024' WHEN T0.\"DocDate\" BETWEEN '2025-01-10' AND '2025-01-20' THEN 'Pongal 2025' END AS \"SaleEvent\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\", SUM(T1.\"Quantity\") AS \"TotalQty\", ROUND(SUM(T0.\"DocTotal\"), 2) AS \"TotalRevenue\", ROUND(AVG(T0.\"DocTotal\"), 2) AS \"AvgOrderValue\", ROUND(SUM(T0.\"U_SpeDis\"), 2) AS \"TotalSpecialDiscount\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" T4 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T4.\"WhsCode\" WHERE ( T0.\"DocDate\" BETWEEN '2024-01-10' AND '2024-01-20' OR T0.\"DocDate\" BETWEEN '2025-01-10' AND '2025-01-20' ) AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND T0.\"CANCELED\" = 'N' GROUP BY CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-10' AND '2024-01-20' THEN 'Pongal 2024' WHEN T0.\"DocDate\" BETWEEN '2025-01-10' AND '2025-01-20' THEN 'Pongal 2025' END ORDER BY \"SaleEvent\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T05:46:06.194373", "query": "SELECT TOP 25 CASE WHEN T0.\"DocDate\" BETWEEN '2023-08-10' AND '2023-08-20' THEN 'Independence 2023' WHEN T0.\"DocDate\" BETWEEN '2024-08-10' AND '2024-08-20' THEN 'Independence 2024' END AS \"SaleEvent\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\", SUM(T1.\"Quantity\") AS \"TotalQty\", ROUND(SUM(T0.\"DocTotal\"), 2) AS \"TotalRevenue\", ROUND(AVG(T0.\"DocTotal\"), 2) AS \"AvgOrderValue\", ROUND(SUM(T0.\"U_SpeDis\"), 2) AS \"TotalSpecialDiscount\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" T4 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T4.\"WhsCode\" WHERE ( T0.\"DocDate\" BETWEEN '2023-08-10' AND '2023-08-20' OR T0.\"DocDate\" BETWEEN '2024-08-10' AND '2024-08-20' ) AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND T0.\"CANCELED\" = 'N' GROUP BY CASE WHEN T0.\"DocDate\" BETWEEN '2023-08-10' AND '2023-08-20' THEN 'Independence 2023' WHEN T0.\"DocDate\" BETWEEN '2024-08-10' AND '2024-08-20' THEN 'Independence 2024' END ORDER BY \"SaleEvent\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:02:26.064414", "query": "SELECT TOP 25 YEAR(T0.\"DocDate\") AS \"Year\", SUM(CASE WHEN (MONTH(T0.\"DocDate\") = 10 AND DAY(T0.\"DocDate\") BETWEEN 17 AND 31) OR (MONTH(T0.\"DocDate\") = 11 AND DAY(T0.\"DocDate\") BETWEEN 1 AND 9) THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2023_Sales\", SUM(CASE WHEN (MONTH(T0.\"DocDate\") = 10 AND DAY(T0.\"DocDate\") BETWEEN 5 AND 19) OR (MONTH(T0.\"DocDate\") = 10 AND DAY(T0.\"DocDate\") BETWEEN 5 AND 19) THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2024_Sales\", SUM(CASE WHEN MONTH(T0.\"DocDate\") = 1 AND DAY(T0.\"DocDate\") BETWEEN 8 AND 22 THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_Sales\" FROM \"OINV\" T0 WHERE T0.\"CANCELED\" = 'N' GROUP BY YEAR(T0.\"DocDate\") ORDER BY YEAR(T0.\"DocDate\") DESC", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"invalid name of function or procedure: DAY: line 1 col 89 (at pos 88)\"}"}
{"timestamp": "2026-09-28T06:02:33.726224", "query": "SELECT TOP 25 YEAR(T0.\"DocDate\") AS \"Year\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-10-17' AND '2023-11-09' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-09' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-01-08' AND '2023-01-22' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-08' AND '2025-01-22' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 WHERE T0.\"CANCELED\" = 'N' GROUP BY YEAR(T0.\"DocDate\") ORDER BY YEAR(T0.\"DocDate\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:02:40.879507", "query": "SELECT TOP 25 IFNULL(NULLIF(T2.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-10-17' AND '2023-11-09' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-09' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-01-08' AND '2023-01-22' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T0.\"DocTotal\" ELSE 0 END) AS \"Pongal_2024\" FROM \"OINV\" T0 LEFT JOIN \"OWHS\" T2 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T2.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' GROUP BY T2.\"U_Location\" ORDER BY \"Diwali_2024\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:11:53.177911", "query": "SELECT TOP 25 IFNULL(T3.\"WhsCode\", 'Unknown') AS \"Branch\", IFNULL(T3.\"WhsName\", 'Unknown') AS \"BranchName\", IFNULL(NULLIF(T3.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OWHS\" T3 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T3.\"WhsCode\" INNER JOIN \"OITB\" T5 ON T2.\"ItmsGrpCod\" = T5.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T5.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND ( T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' OR T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' OR T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' OR T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' ) GROUP BY T3.\"WhsCode\", T3.\"WhsName\", T3.\"U_Location\" ORDER BY ( SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) ) DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-28T06:12:03.051711", "query": "SELECT TOP 25 IFNULL(T3.\"WhsCode\", 'Unknown') AS \"Branch\", IFNULL(T3.\"WhsName\", 'Unknown') AS \"BranchName\", IFNULL(NULLIF(T3.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OWHS\" T3 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T3.\"WhsCode\" INNER JOIN \"OITB\" T5 ON T2.\"ItmsGrpCod\" = T5.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T5.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND ( T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' OR T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' OR T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' OR T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' ) GROUP BY T3.\"WhsCode\", T3.\"WhsName\", T3.\"U_Location\" ORDER BY \"Diwali_2024\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:12:13.106885", "query": "SELECT TOP 25 IFNULL(T3.\"WhsCode\", 'Unknown') AS \"Branch\", IFNULL(T3.\"WhsName\", 'Unknown') AS \"BranchName\", IFNULL(NULLIF(T3.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OWHS\" T3 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T3.\"WhsCode\" INNER JOIN \"OITB\" T5 ON T2.\"ItmsGrpCod\" = T5.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND LOWER(T3.\"WhsName\") NOT LIKE '%cwh%' AND T5.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND ( T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' OR T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' OR T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' OR T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' ) GROUP BY T3.\"WhsCode\", T3.\"WhsName\", T3.\"U_Location\" ORDER BY \"Diwali_2024\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T06:12:22.345489", "query": "SELECT TOP 25 T0.\"BPLId\" AS \"BranchID\", IFNULL(T4.\"BPLName\", 'Unknown') AS \"BranchName\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T5 ON T2.\"ItmsGrpCod\" = T5.\"ItmsGrpCod\" LEFT JOIN \"OBPL\" T4 ON T0.\"BPLId\" = T4.\"BPLId\" WHERE T0.\"CANCELED\" = 'N' AND T5.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND ( T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' OR T0.\"DocDate\" BETWEEN '2024-10-24' AND '2024-11-07' OR T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' OR T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' ) GROUP BY T0.\"BPLId\", T4.\"BPLName\" ORDER BY \"Diwali_2024\" DESC", "status": "SUCCESS", "details": ""}
