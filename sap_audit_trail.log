{"timestamp": "2026-09-29T02:49:56.487064", "query": "SELECT TOP 25 \"Category\", \"Brand\", \"TotalSales\", \"TotalQty\", \"RNK\" FROM ( SELECT T2.\"U_HC\" AS \"Category\", T3.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalSales\", SUM(T1.\"Quantity\") AS \"TotalQty\", RANK() OVER ( PARTITION BY T2.\"U_HC\" ORDER BY SUM(T1.\"LineTotal\") DESC ) AS \"RNK\" FROM \"INV1\" T1 INNER JOIN \"OINV\" T0 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T2.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" LEFT JOIN \"OWHS\" OWHS ON OWHS.\"WhsCode\" = T1.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Carry Bag%' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND T2.\"U_HC\" IS NOT NULL AND T2.\"U_HC\" <> '' GROUP BY T2.\"U_HC\", T3.\"ItmsGrpNam\" ) WHERE \"RNK\" <= 3 ORDER BY \"Category\", \"RNK\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:02:44.010412", "query": "SELECT TOP 25 OITB.\"ItmsGrpNam\" AS \"Category\", T1.\"WhsCode\", OITM.\"ItmsGrpCod\", T2.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalSales\", SUM(T1.\"Quantity\") AS \"TotalQty\", COUNT(DISTINCT T0.\"DocEntry\") AS \"InvoiceCount\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" OITM ON T1.\"ItemCode\" = OITM.\"ItemCode\" INNER JOIN \"OITB\" T2 ON OITM.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" INNER JOIN \"OITB\" OITB ON OITM.\"ItmsGrpCod\" = OITB.\"ItmsGrpCod\" INNER JOIN \"OWHS\" ON T1.\"WhsCode\" = \"OWHS\".\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" NOT LIKE '%DEF%' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' AND OITM.\"ItemName\" NOT LIKE '%Carry Bag%' AND T2.\"ItmsGrpNam\" NOT LIKE '%Carry Bag%' GROUP BY OITB.\"ItmsGrpNam\", T1.\"WhsCode\", OITM.\"ItmsGrpCod\", T2.\"ItmsGrpNam\" ORDER BY \"TotalSales\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:02:58.237354", "query": "SELECT TOP 25 OITM.\"U_HC\" AS \"HeadCategory\", T2.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalSales\", SUM(T1.\"Quantity\") AS \"TotalQty\", COUNT(DISTINCT T0.\"DocEntry\") AS \"InvoiceCount\", ROUND(SUM(T1.\"LineTotal\") / NULLIF(SUM(T1.\"Quantity\"), 0), 2) AS \"AvgSellPrice\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" OITM ON T1.\"ItemCode\" = OITM.\"ItemCode\" INNER JOIN \"OITB\" T2 ON OITM.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" INNER JOIN \"OWHS\" ON T1.\"WhsCode\" = \"OWHS\".\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" NOT LIKE '%DEF%' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' AND OITM.\"ItemName\" NOT LIKE '%Carry Bag%' AND T2.\"ItmsGrpNam\" NOT LIKE '%Carry Bag%' AND OITM.\"U_HC\" IS NOT NULL AND OITM.\"U_HC\" != '' GROUP BY OITM.\"U_HC\", T2.\"ItmsGrpNam\" ORDER BY \"TotalSales\" DESC", "status": "SUCCESS", "details": ""}
