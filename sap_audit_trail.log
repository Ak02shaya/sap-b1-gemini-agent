{"timestamp": "2026-09-28T08:31:26.368730", "query": "SELECT TOP 25 D.\"Category\", D.\"Brand\", D.\"Net Sales\", D.\"Qty Sold\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"Category\", T2.\"U_Brand\" AS \"Brand\", ROUND(SUM(S.\"LineTotal\"), 2) AS \"Net Sales\", ROUND(SUM(S.\"Quantity\"), 2) AS \"Qty Sold\" FROM ( SELECT T1.\"LineTotal\", T1.\"Quantity\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' UNION ALL SELECT -T1.\"LineTotal\", -T1.\"Quantity\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"ORIN\" T0 INNER JOIN \"RIN1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' ) S INNER JOIN \"OITM\" T2 ON S.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE UPPER(S.\"WhsCode\") NOT LIKE 'CWH%' AND LOWER(T3.\"ItmsGrpNam\") NOT LIKE '%defective%' AND LOWER(T2.\"ItemName\") NOT LIKE '%carry bag%' AND T2.\"U_Brand\" IS NOT NULL AND T2.\"U_Brand\" <> '' GROUP BY T3.\"ItmsGrpNam\", T2.\"U_Brand\" ) D INNER JOIN ( SELECT T3B.\"ItmsGrpNam\" AS \"Category\", T2B.\"U_Brand\" AS \"Brand\", SUM(SB.\"LineTotal\") AS \"CatBrandSales\" FROM ( SELECT T1.\"LineTotal\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' UNION ALL SELECT -T1.\"LineTotal\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"ORIN\" T0 INNER JOIN \"RIN1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' ) SB INNER JOIN \"OITM\" T2B ON SB.\"ItemCode\" = T2B.\"ItemCode\" INNER JOIN \"OITB\" T3B ON T2B.\"ItmsGrpCod\" = T3B.\"ItmsGrpCod\" WHERE UPPER(SB.\"WhsCode\") NOT LIKE 'CWH%' AND LOWER(T3B.\"ItmsGrpNam\") NOT LIKE '%defective%' AND LOWER(T2B.\"ItemName\") NOT LIKE '%carry bag%' AND T2B.\"U_Brand\" IS NOT NULL AND T2B.\"U_Brand\" <> '' GROUP BY T3B.\"ItmsGrpNam\", T2B.\"U_Brand\" ) R2 ON D.\"Category\" = R2.\"Category\" AND D.\"Brand\" = R2.\"Brand\" WHERE ( SELECT COUNT(*) FROM ( SELECT T3C.\"ItmsGrpNam\" AS \"Category\", T2C.\"U_Brand\" AS \"Brand\", SUM(SC.\"LineTotal\") AS \"Sales\" FROM ( SELECT T1.\"LineTotal\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' UNION ALL SELECT -T1.\"LineTotal\", T1.\"ItemCode\", T1.\"WhsCode\" FROM \"ORIN\" T0 INNER JOIN \"RIN1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' ) SC INNER JOIN \"OITM\" T2C ON SC.\"ItemCode\" = T2C.\"ItemCode\" INNER JOIN \"OITB\" T3C ON T2C.\"ItmsGrpCod\" = T3C.\"ItmsGrpCod\" WHERE UPPER(SC.\"WhsCode\") NOT LIKE 'CWH%' AND LOWER(T3C.\"ItmsGrpNam\") NOT LIKE '%defective%' AND LOWER(T2C.\"ItemName\") NOT LIKE '%carry bag%' AND T2C.\"U_Brand\" IS NOT NULL AND T2C.\"U_Brand\" <> '' GROUP BY T3C.\"ItmsGrpNam\", T2C.\"U_Brand\" ) INNER_RANK WHERE INNER_RANK.\"Category\" = D.\"Category\" AND INNER_RANK.\"Sales\" > D.\"Net Sales\" ) < 3 ORDER BY D.\"Category\", D.\"Net Sales\" DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\