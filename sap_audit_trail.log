{"timestamp": "2026-09-29T06:35:23.799390", "query": "SELECT TOP 25 \"ProductCategory\", \"Brand\", \"TotalRevenue\", \"TotalQuantity\", \"TotalOrders\", \"CategoryRank\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"ProductCategory\", T3.\"U_Brand\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalOrders\", RANK() OVER ( PARTITION BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC ) AS \"CategoryRank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T3.\"ItmsGrpNam\", T3.\"U_Brand\" ) AS \"RankedBrands\" WHERE \"CategoryRank\" <= 3 ORDER BY \"ProductCategory\", \"CategoryRank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:35:37.175882", "query": "SELECT TOP 25 \"ProductCategory\", \"Brand\", \"TotalRevenue\", \"TotalQuantity\", \"TotalOrders\", \"CategoryRank\" FROM ( SELECT T3.\"ItmsGrpNam\" AS \"ProductCategory\", T3.\"U_Brand\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalOrders\", RANK() OVER ( PARTITION BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC ) AS \"CategoryRank\", COUNT(DISTINCT T3.\"U_Brand\") OVER (PARTITION BY T3.\"ItmsGrpNam\") AS \"BrandCount\", SUM(SUM(T1.\"LineTotal\")) OVER (PARTITION BY T3.\"ItmsGrpNam\") AS \"CategoryTotalRevenue\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T3.\"ItmsGrpNam\", T3.\"U_Brand\" ) AS \"RankedBrands\" WHERE \"CategoryRank\" <= 3 AND \"BrandCount\" >= 2 ORDER BY \"CategoryTotalRevenue\" DESC, \"ProductCategory\", \"CategoryRank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:35:59.461148", "query": "SELECT TOP 25 \"CategoryGroup\", \"Brand\", \"TotalRevenue\", \"TotalQuantity\", \"TotalOrders\", \"BrandRank\" FROM ( SELECT CASE WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%PANEL%' THEN 'TELEVISION / PANEL' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '% WM%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%WASHING%' THEN 'WASHING MACHINE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%REF%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' THEN 'REFRIGERATOR' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE 'MOB-%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%MOBILE%' THEN 'MOBILE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%LAPTOP%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%LAP TOP%' THEN 'LAPTOP' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AC%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%AIR CON%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SPLIT%' THEN 'AIR CONDITIONER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AUDIO%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SOUND%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SPEAKER%' THEN 'AUDIO' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER HEAT%' THEN 'WATER HEATER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER PURI%' THEN 'WATER PURIFIER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MICRO%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%OVEN%' THEN 'MICROWAVE / OVEN' ELSE NULL END AS \"CategoryGroup\", T3.\"U_Brand\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalOrders\", RANK() OVER ( PARTITION BY CASE WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%PANEL%' THEN 'TELEVISION / PANEL' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '% WM%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%WASHING%' THEN 'WASHING MACHINE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%REF%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' THEN 'REFRIGERATOR' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE 'MOB-%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%MOBILE%' THEN 'MOBILE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%LAPTOP%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%LAP TOP%' THEN 'LAPTOP' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AC%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%AIR CON%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SPLIT%' THEN 'AIR CONDITIONER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%AUDIO%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SOUND%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%SPEAKER%' THEN 'AUDIO' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER HEAT%' THEN 'WATER HEATER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER PURI%' THEN 'WATER PURIFIER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%MICRO%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%OVEN%' THEN 'MICROWAVE / OVEN' ELSE NULL END ORDER BY SUM(T1.\"LineTotal\") DESC ) AS \"BrandRank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T3.\"ItmsGrpNam\", T3.\"U_Brand\" ) AS \"RankedBrands\" WHERE \"CategoryRank\" <= 3 AND \"CategoryGroup\" IS NOT NULL ORDER BY \"CategoryGroup\", \"BrandRank\"", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-29T06:36:11.498500", "query": "SELECT TOP 25 \"CategoryGroup\", \"Brand\", \"TotalRevenue\", \"TotalQuantity\", \"TotalOrders\", \"BrandRank\" FROM ( SELECT \"CategoryGroup\", \"Brand\", SUM(\"LineTotal\") AS \"TotalRevenue\", SUM(\"Qty\") AS \"TotalQuantity\", COUNT(DISTINCT \"DocNum\") AS \"TotalOrders\", RANK() OVER (PARTITION BY \"CategoryGroup\" ORDER BY SUM(\"LineTotal\") DESC) AS \"BrandRank\" FROM ( SELECT CASE WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%PANEL%' THEN 'TELEVISION / PANEL' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '% WM%' THEN 'WASHING MACHINE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%REF%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' THEN 'REFRIGERATOR' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE 'MOB-%' THEN 'MOBILE' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%LAPTOP%' OR UPPER(T3.\"ItmsGrpNam\") LIKE '%LAP TOP%' THEN 'LAPTOP' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER HEAT%' THEN 'WATER HEATER' WHEN UPPER(T3.\"ItmsGrpNam\") LIKE '%WATER PURI%' THEN 'WATER PURIFIER' ELSE NULL END AS \"CategoryGroup\", T3.\"U_Brand\" AS \"Brand\", T1.\"LineTotal\" AS \"LineTotal\", T1.\"Quantity\" AS \"Qty\", T0.\"DocNum\" AS \"DocNum\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' ) AS \"Base\" WHERE \"CategoryGroup\" IS NOT NULL GROUP BY \"CategoryGroup\", \"Brand\" ) AS \"Ranked\" WHERE \"BrandRank\" <= 3 ORDER BY \"CategoryGroup\", \"BrandRank\"", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-29T06:36:18.647903", "query": "SELECT TOP 3 'TELEVISION / PANEL' AS \"CategoryGroup\", T3.\"U_Brand\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalOrders\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND UPPER(T3.\"ItmsGrpNam\") LIKE '%PANEL%' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T3.\"U_Brand\" ORDER BY \"TotalRevenue\" DESC", "status": "SUCCESS", "details": ""}
