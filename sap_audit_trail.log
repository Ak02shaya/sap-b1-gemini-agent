{"timestamp": "2026-09-28T09:53:54.968926", "query": "SELECT TOP 50 YEAR(T0.\"DocDate\") AS \"Year\", SUM(T0.\"DocTotal\" - T0.\"VatSum\" - IFNULL(T0.\"TotalExpns\", 0)) AS \"Net Sales Revenue\", COUNT(DISTINCT T0.\"DocEntry\") AS \"Total Invoices\", COUNT(DISTINCT T0.\"CardCode\") AS \"Unique Customers\" FROM \"OINV\" T0 WHERE T0.\"CANCELED\" = 'N' AND YEAR(T0.\"DocDate\") BETWEEN 2022 AND 2025 GROUP BY YEAR(T0.\"DocDate\") ORDER BY YEAR(T0.\"DocDate\") ASC", "status": "SUCCESS", "details": ""}
