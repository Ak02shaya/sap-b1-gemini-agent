{"timestamp": "2026-09-29T06:07:22.854525", "query": "SELECT TOP 25 T2.\"U_GC\" AS \"ProductCategory\", T3.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T2.\"U_GC\" IS NOT NULL AND T2.\"U_GC\" != '' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T2.\"U_GC\", T3.\"ItmsGrpNam\" ORDER BY T2.\"U_GC\", SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:07:34.002841", "query": "SELECT TOP 25 \"ProductCategory\", \"Brand\", \"TotalRevenue\", \"TotalQuantity\", \"TotalInvoices\", \"CategoryRank\" FROM ( SELECT T2.\"U_GC\" AS \"ProductCategory\", T3.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\", RANK() OVER (PARTITION BY T2.\"U_GC\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"CategoryRank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T2.\"U_GC\" IS NOT NULL AND T2.\"U_GC\" != '' AND T3.\"U_Brand\" IS NOT NULL AND T3.\"U_Brand\" != '' GROUP BY T2.\"U_GC\", T3.\"ItmsGrpNam\" ) AS \"RankedBrands\" WHERE \"CategoryRank\" = 1 ORDER BY \"TotalRevenue\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:09:13.323732", "query": "SELECT TOP 25 T1.\"ItemCode\" AS \"Item1Code\", T1.\"Dscription\" AS \"Item1Name\", T2.\"ItemCode\" AS \"Item2Code\", T2.\"Dscription\" AS \"Item2Name\", COUNT(DISTINCT T1.\"DocEntry\") AS \"CoOccurrenceCount\", SUM(T1.\"LineTotal\" + T2.\"LineTotal\") AS \"TotalRevenue\", AVG(T1.\"Price\" + T2.\"Price\") AS \"AvgCombinedPrice\" FROM \"INV1\" T1 INNER JOIN \"INV1\" T2 ON T1.\"DocEntry\" = T2.\"DocEntry\" AND T1.\"ItemCode\" < T2.\"ItemCode\" INNER JOIN \"OINV\" T0 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" OI1 ON OI1.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OITM\" OI2 ON OI2.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" OG1 ON OG1.\"ItmsGrpCod\" = OI1.\"ItmsGrpCod\" INNER JOIN \"OITB\" OG2 ON OG2.\"ItmsGrpCod\" = OI2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' AND T2.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T2.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY T1.\"ItemCode\", T1.\"Dscription\", T2.\"ItemCode\", T2.\"Dscription\" ORDER BY \"CoOccurrenceCount\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:19:03.540931", "query": "SELECT \"TableID\", \"AliasID\", \"Descr\" FROM \"CUFD\" WHERE \"TableID\" = 'OWHS' AND (LOWER(\"Descr\") LIKE '%branch%' OR LOWER(\"AliasID\") LIKE '%branch%')", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:19:10.336993", "query": "SELECT TOP 25 OWHS.\"WhsName\" AS \"BranchName\", OWHS.\"WhsCode\" AS \"BranchCode\", OWHS.\"U_Location\" AS \"BranchLocation\", OWHS.\"U_BranchType\" AS \"BranchType\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\", SUM(T1.\"Quantity\") AS \"TotalQuantity\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY OWHS.\"WhsName\", OWHS.\"WhsCode\", OWHS.\"U_Location\", OWHS.\"U_BranchType\" ORDER BY \"TotalRevenue\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:21:39.088427", "query": "SELECT TOP 25 T1A.\"ItemCode\" AS \"Item1Code\", T1A.\"Dscription\" AS \"Item1Name\", T1B.\"ItemCode\" AS \"Item2Code\", T1B.\"Dscription\" AS \"Item2Name\", COUNT(DISTINCT T1A.\"DocEntry\") AS \"CoOccurrenceCount\", SUM(T1A.\"LineTotal\" + T1B.\"LineTotal\") AS \"TotalRevenue\" FROM \"INV1\" T1A INNER JOIN \"OINV\" T0A ON T0A.\"DocEntry\" = T1A.\"DocEntry\" AND T0A.\"CANCELED\" = 'N' AND T0A.\"DocType\" = 'I' INNER JOIN \"INV1\" T1B ON T1B.\"DocEntry\" = T1A.\"DocEntry\" AND T1B.\"LineNum\" > T1A.\"LineNum\" AND T1B.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1B.\"Dscription\") NOT LIKE '%carry bag%' INNER JOIN \"OWHS\" WA ON WA.\"WhsCode\" = T1A.\"WhsCode\" AND WA.\"WhsName\" NOT LIKE '%defect%' AND WA.\"WhsName\" NOT LIKE '%Defect%' INNER JOIN \"OWHS\" WB ON WB.\"WhsCode\" = T1B.\"WhsCode\" AND WB.\"WhsName\" NOT LIKE '%defect%' AND WB.\"WhsName\" NOT LIKE '%Defect%' WHERE T1A.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1A.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY T1A.\"ItemCode\", T1A.\"Dscription\", T1B.\"ItemCode\", T1B.\"Dscription\" ORDER BY \"CoOccurrenceCount\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:25:05.287701", "query": "SELECT TOP 25 T1A.\"ItemCode\" AS \"Item1Code\", T1A.\"Dscription\" AS \"Item1Name\", T1B.\"ItemCode\" AS \"Item2Code\", T1B.\"Dscription\" AS \"Item2Name\", COUNT(DISTINCT T1A.\"DocEntry\") AS \"CoOccurrenceCount\", SUM(T1A.\"LineTotal\" + T1B.\"LineTotal\") AS \"TotalRevenue\" FROM \"INV1\" T1A INNER JOIN \"OINV\" T0A ON T0A.\"DocEntry\" = T1A.\"DocEntry\" AND T0A.\"CANCELED\" = 'N' AND T0A.\"DocType\" = 'I' INNER JOIN \"INV1\" T1B ON T1B.\"DocEntry\" = T1A.\"DocEntry\" AND T1B.\"LineNum\" > T1A.\"LineNum\" AND T1B.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1B.\"Dscription\") NOT LIKE '%carry bag%' INNER JOIN \"OWHS\" WA ON WA.\"WhsCode\" = T1A.\"WhsCode\" AND WA.\"WhsName\" NOT LIKE '%defect%' AND WA.\"WhsName\" NOT LIKE '%Defect%' INNER JOIN \"OWHS\" WB ON WB.\"WhsCode\" = T1B.\"WhsCode\" AND WB.\"WhsName\" NOT LIKE '%defect%' AND WB.\"WhsName\" NOT LIKE '%Defect%' WHERE T1A.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1A.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY T1A.\"ItemCode\", T1A.\"Dscription\", T1B.\"ItemCode\", T1B.\"Dscription\" ORDER BY \"CoOccurrenceCount\" DESC", "status": "SUCCESS", "details": ""}
