{"timestamp": "2026-09-29T06:29:36.742108", "query": "SELECT \"TableID\", \"AliasID\", \"Descr\" FROM \"CUFD\" WHERE \"TableID\" = 'OITW'", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:29:46.520929", "query": "SELECT TOP 25 OWHS.\"WhsName\" AS \"WarehouseName\", OWHS.\"WhsCode\" AS \"WarehouseCode\", T3.\"ItmsGrpNam\" AS \"ProductCategory\", SUM(T1.\"OnHand\") AS \"TotalStockQuantity\", SUM(T1.\"OnHand\" * T2.\"AvgPrice\") AS \"TotalStockValue\" FROM \"OITW\" T1 INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T1.\"OnHand\" > 0 AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T2.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T2.\"ItemName\") NOT LIKE '%carry bag%' GROUP BY OWHS.\"WhsName\", OWHS.\"WhsCode\", T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"OnHand\" * T2.\"AvgPrice\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:29:55.937317", "query": "SELECT TOP 25 OWHS.\"WhsName\" AS \"WarehouseName\", OWHS.\"WhsCode\" AS \"WarehouseCode\", T3.\"ItmsGrpNam\" AS \"ProductCategory\", SUM(T1.\"OnHand\") AS \"TotalStockQuantity\", SUM(T1.\"StockValue\") AS \"TotalStockValue\" FROM \"OITW\" T1 INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T1.\"OnHand\" > 0 AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T2.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T2.\"ItemName\") NOT LIKE '%carry bag%' GROUP BY OWHS.\"WhsName\", OWHS.\"WhsCode\", T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"StockValue\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T06:33:06.119748", "query": "SELECT TOP 25 T0.\"CardName\" AS \"SupplierName\", T3.\"ItmsGrpNam\" AS \"ProductCategory\", SUM(T1.\"LineTotal\") AS \"TotalPurchaseValue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocNum\") AS \"TotalInvoices\", COUNT(DISTINCT T1.\"ItemCode\") AS \"UniqueItems\" FROM \"OPCH\" T0 INNER JOIN \"PCH1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' GROUP BY T0.\"CardName\", T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
