{"timestamp": "2026-09-29T03:13:07.193559", "query": "SELECT TOP 25 OWHS.\"WhsName\" AS \"Warehouse / Branch\", LC.\"Location\" AS \"State\", COUNT(DISTINCT T0.\"DocEntry\") AS \"Total Invoices\", SUM(T1.\"Quantity\") AS \"Total Qty Sold\", SUM(T1.\"LineTotal\") AS \"Total Revenue (INR)\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" INNER JOIN \"OLCT\" LC ON OWHS.\"Location\" = LC.\"Code\" WHERE T0.\"CANCELED\" = 'N' AND OWHS.\"WhsName\" NOT LIKE '%DEFECT%' AND OWHS.\"WhsName\" NOT LIKE '%TRANSIT%' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' GROUP BY OWHS.\"WhsName\", LC.\"Location\" ORDER BY \"Total Revenue (INR)\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T03:13:14.842201", "query": "SELECT TOP 10 LC.\"Location\" AS \"State\", COUNT(DISTINCT OWHS.\"WhsCode\") AS \"Branch Count\", COUNT(DISTINCT T0.\"DocEntry\") AS \"Total Invoices\", SUM(T1.\"Quantity\") AS \"Total Qty Sold\", SUM(T1.\"LineTotal\") AS \"Total Revenue (INR)\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" INNER JOIN \"OLCT\" LC ON OWHS.\"Location\" = LC.\"Code\" WHERE T0.\"CANCELED\" = 'N' AND OWHS.\"WhsName\" NOT LIKE '%DEFECT%' AND OWHS.\"WhsName\" NOT LIKE '%TRANSIT%' AND T1.\"ItemCode\" NOT LIKE '%CARRY%' GROUP BY LC.\"Location\" ORDER BY \"Total Revenue (INR)\" DESC", "status": "SUCCESS", "details": ""}
