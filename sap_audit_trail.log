{"timestamp": "2026-09-28T15:52:08.331622", "query": "SELECT TOP 25 T_RANKED.\"Category\", T_RANKED.\"Brand\", T_RANKED.\"TotalRevenue\", T_RANKED.\"TotalQuantity\", T_RANKED.\"InvoiceCount\", T_RANKED.\"BrandRank\" FROM ( SELECT OITB.\"ItmsGrpNam\" AS \"Category\", OITB.\"U_Brand\" AS \"Brand\", ROUND(SUM(T1.\"LineTotal\"), 2) AS \"TotalRevenue\", CAST(SUM(T1.\"Quantity\") AS INTEGER) AS \"TotalQuantity\", COUNT(DISTINCT T0.\"DocEntry\") AS \"InvoiceCount\", RANK() OVER ( PARTITION BY OITB.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC ) AS \"BrandRank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" ON T2.\"ItmsGrpCod\" = OITB.\"ItmsGrpCod\" INNER JOIN \"OWHS\" ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T2.\"ItemName\") NOT LIKE '%carry bag%' AND OITB.\"U_Brand\" IS NOT NULL AND OITB.\"U_Brand\" <> '' GROUP BY OITB.\"ItmsGrpNam\", OITB.\"U_Brand\" ) T_RANKED WHERE T_RANKED.\"BrandRank\" <= 3 ORDER BY T_RANKED.\"Category\", T_RANKED.\"BrandRank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T16:00:11.694393", "query": "SELECT TOP 25 T5.\"ItmsGrpNam\" AS \"Category\", T3.\"ItmsGrpNam\" AS \"Brand\", RANK() OVER (PARTITION BY T5.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"RevenueRank\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", SUM(T1.\"Quantity\") AS \"TotalQuantity\", COUNT(DISTINCT T1.\"DocEntry\") AS \"InvoiceCount\" FROM \"INV1\" T1 INNER JOIN \"OINV\" T0 ON T1.\"DocEntry\" = T0.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OITB\" T5 ON T2.\"U_Category\" = T5.\"ItmsGrpCod\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND OWHS.\"WhsName\" NOT LIKE '%Defective%' AND T0.\"DocType\" = 'I' AND T1.\"ItemCode\" NOT LIKE '%CARRY%BAG%' AND T5.\"ItmsGrpNam\" IN ( SELECT \"ItmsGrpNam\" FROM ( SELECT TB2.\"ItmsGrpNam\", COUNT(DISTINCT TB1.\"ItmsGrpCod\") AS \"BrandCount\" FROM \"OITM\" IT INNER JOIN \"OITB\" TB1 ON IT.\"ItmsGrpCod\" = TB1.\"ItmsGrpCod\" INNER JOIN \"OITB\" TB2 ON IT.\"U_Category\" = TB2.\"ItmsGrpCod\" GROUP BY TB2.\"ItmsGrpNam\" HAVING COUNT(DISTINCT TB1.\"ItmsGrpCod\") > 1 ) MULTI ) GROUP BY T5.\"ItmsGrpNam\", T3.\"ItmsGrpNam\" HAVING RANK() OVER (PARTITION BY T5.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC) <= 3 ORDER BY T5.\"ItmsGrpNam\", \"RevenueRank\"", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"invalid column name: IT.U_Category: line 1 col 948 (at pos 947)\"}"}
