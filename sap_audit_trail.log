{"timestamp": "2026-09-28T06:29:02.218864", "query": "SELECT TOP 25 IFNULL(NULLIF(T3.\"WhsName\", ''), 'Unassigned') AS \"Branch\", IFNULL(NULLIF(T3.\"U_Location\", ''), 'Unassigned') AS \"Location\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2023\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Diwali_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2024\", SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) AS \"Pongal_2025\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OWHS\" T3 ON TO_VARCHAR(T0.\"U_ReqWhs\") = T3.\"WhsCode\" INNER JOIN \"OITB\" T4 ON T2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND TO_VARCHAR(T0.\"U_ReqWhs\") NOT LIKE 'CWH%' AND T3.\"WhsName\" NOT LIKE '%CWH%' AND T4.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T3.\"WhsName\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND ( T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' OR T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' OR T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' OR T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' ) GROUP BY T3.\"WhsName\", T3.\"U_Location\" HAVING SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2023-11-05' AND '2023-11-19' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-10-25' AND '2024-11-08' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2024-01-08' AND '2024-01-22' THEN T1.\"LineTotal\" ELSE 0 END) + SUM(CASE WHEN T0.\"DocDate\" BETWEEN '2025-01-07' AND '2025-01-21' THEN T1.\"LineTotal\" ELSE 0 END) > 0 ORDER BY (\"Diwali_2023\" + \"Diwali_2024\" + \"Pongal_2024\" + \"Pongal_2025\") DESC", "status": "API_ERROR"