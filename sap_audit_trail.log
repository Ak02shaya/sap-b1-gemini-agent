{"timestamp": "2026-09-21T06:35:17.285329", "query": "SELECT TOP 20 G.\"ItmsGrpNam\" AS \"Product Category\", SUM(T1.\"LineTotal\") AS \"Total Sales Value\", SUM(T1.\"Quantity\") AS \"Total Quantity Sold\", ROUND(SUM(T1.\"LineTotal\") / NULLIF(SUM(T1.\"Quantity\"), 0), 2) AS \"Avg Price Per Unit\" FROM INV1 T1 INNER JOIN OINV T0 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T2.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN OITB G ON G.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' GROUP BY G.\"ItmsGrpNam\" ORDER BY \"Total Sales Value\" DESC, \"Total Quantity Sold\" ASC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-21T06:37:48.333549", "query": "SELECT TOP 20 T0.\"ItemCode\", T0.\"ItemName\", T1.\"WhsCode\", T1.\"WhsName\", T0.\"OnHand\" AS \"TotalStock\", T2.\"OnHand\" AS \"WhsStock\", T2.\"IsCommited\" AS \"Committed\", T2.\"OnOrder\" AS \"OnOrder\" FROM OITM T0 INNER JOIN OWHS T1 ON T1.\"WhsCode\" = T1.\"WhsCode\" INNER JOIN OITW T2 ON T2.\"ItemCode\" = T0.\"ItemCode\" AND T2.\"WhsCode\" = T1.\"WhsCode\" WHERE T2.\"OnHand\" > 0 AND T0.\"ItemCode\" IN ( SELECT \"ItemCode\" FROM OITW WHERE \"OnHand\" > 0 GROUP BY \"ItemCode\" HAVING COUNT(DISTINCT \"WhsCode\") > 1 ) ORDER BY T0.\"ItemCode\", T2.\"OnHand\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-21T06:39:42.833797", "query": "SELECT TOP 20 T1.\"ItemCode\", T1.\"Dscription\" AS \"ItemName\", T2.\"ItmsGrpNam\" AS \"Category\", T0.\"CardName\" AS \"SupplierName\", SUM(T1.\"Quantity\") AS \"TotalPurchaseQty\", SUM(T1.\"LineTotal\") AS \"TotalPurchaseValue\", ROUND(SUM(T1.\"LineTotal\") / SUM(T1.\"Quantity\"), 2) AS \"AvgUnitCost\" FROM OPOR T0 INNER JOIN POR1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN OITB T2 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T0.\"DocStatus\" = 'C' GROUP BY T1.\"ItemCode\", T1.\"Dscription\", T2.\"ItmsGrpNam\", T0.\"CardName\" ORDER BY SUM(T1.\"Quantity\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-21T06:59:44.416320", "query": "SELECT TOP 20 T1.\"ItemCode\" AS ItemCode1, T2.\"ItemCode\" AS ItemCode2, MIN(T1.\"Dscription\") AS ProductName1, MIN(T2.\"Dscription\") AS ProductName2, COUNT(DISTINCT T1.\"DocEntry\") AS CoOccurrenceCount FROM INV1 T1 JOIN INV1 T2 ON T1.\"DocEntry\" = T2.\"DocEntry\" AND T1.\"ItemCode\" < T2.\"ItemCode\" JOIN OINV T0 ON T1.\"DocEntry\" = T0.\"DocEntry\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T1.\"ItemCode\", T2.\"ItemCode\" ORDER BY CoOccurrenceCount DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-21T07:16:37.440776", "query": "SELECT TOP 20 T0.\"CardName\" AS Supplier, T3.\"ItmsGrpNam\" AS ProductCategory, SUM(T1.\"LineTotal\") AS PurchaseValue FROM OPCH T0 INNER JOIN PCH1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T0.\"CardName\", T3.\"ItmsGrpNam\" ORDER BY PurchaseValue DESC", "status": "SUCCESS", "details": ""}
