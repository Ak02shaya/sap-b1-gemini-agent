{"timestamp": "2026-09-28T09:14:58.452423", "query": "SELECT TOP 25 \"Group Category\", \"Brand\", \"Total Quantity\", \"Total Sales\", \"Sales Rank\" FROM ( SELECT T3.\"U_GC\" AS \"Group Category\", T4.\"ItmsGrpNam\" AS \"Brand\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Sales\", RANK() OVER (PARTITION BY T3.\"U_GC\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"Sales Rank\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T3.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEFECTIVE' AND T3.\"ItemName\" NOT LIKE '%Carry Bag%' AND T3.\"ItemName\" NOT LIKE '%PAI Carry Bag%' AND T3.\"U_GC\" IS NOT NULL AND T3.\"U_GC\" != '' GROUP BY T3.\"U_GC\", T4.\"ItmsGrpNam\" ) WHERE \"Sales Rank\" <= 3 ORDER BY \"Group Category\", \"Sales Rank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T09:18:22.322892", "query": "SELECT TOP 25 T3.\"ItmsGrpNam\" AS \"Category\", T2.\"FirmName\" AS \"Brand\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Sales\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T4 ON T1.\"ItemCode\" = T4.\"ItemCode\" INNER JOIN \"OMRC\" T2 ON T4.\"FirmCode\" = T2.\"FirmCode\" INNER JOIN \"OITB\" T3 ON T4.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" LEFT JOIN \"OWHS\" TWH ON T0.\"U_ReqWhs\" = TWH.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEF' AND T4.\"ItemName\" NOT LIKE '%Carry Bag%' AND T4.\"ItemName\" NOT LIKE '%carry bag%' AND T1.\"LineTotal\" > 0 GROUP BY T3.\"ItmsGrpNam\", T2.\"FirmName\" ORDER BY T3.\"ItmsGrpNam\", SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T09:18:46.678597", "query": "SELECT TOP 25 CASE WHEN T3.\"ItmsGrpNam\" LIKE 'MOB-%' OR T3.\"ItmsGrpNam\" LIKE '%MOBILE%' OR T3.\"ItmsGrpNam\" LIKE '%TABLET%' OR T3.\"ItmsGrpNam\" LIKE '%SMART PHONE%' THEN 'DIG - Digital/Mobile' WHEN T3.\"ItmsGrpNam\" LIKE '%REFRIGERATOR%' OR T3.\"ItmsGrpNam\" LIKE '%WASHING%' OR T3.\"ItmsGrpNam\" LIKE '%AIR CONDITIONER%' OR T3.\"ItmsGrpNam\" LIKE '%DISHWASHER%' OR T3.\"ItmsGrpNam\" LIKE 'SAMSUNG REF%' OR T3.\"ItmsGrpNam\" LIKE 'LG REF%' OR T3.\"ItmsGrpNam\" LIKE '%WM%' OR T3.\"ItmsGrpNam\" LIKE '%A/C%' THEN 'HA - Home Appliances' WHEN T3.\"ItmsGrpNam\" LIKE '%PANEL%' OR T3.\"ItmsGrpNam\" LIKE '%TV%' OR T3.\"ItmsGrpNam\" LIKE '%AUDIO%' OR T3.\"ItmsGrpNam\" LIKE '%HOME THEATRE%' THEN 'CE - Consumer Electronics' WHEN T3.\"ItmsGrpNam\" LIKE '%LAP TOP%' OR T3.\"ItmsGrpNam\" LIKE '%LAPTOP%' OR T3.\"ItmsGrpNam\" LIKE '%PRINTER%' OR T3.\"ItmsGrpNam\" LIKE '%DESKTOP%' THEN 'IT - Information Technology' WHEN T3.\"ItmsGrpNam\" LIKE '%WATER PURIFIER%' OR T3.\"ItmsGrpNam\" LIKE '%GAS STOVE%' OR T3.\"ItmsGrpNam\" LIKE '%AIR COOLER%' OR T3.\"ItmsGrpNam\" LIKE '%MIXER%' OR T3.\"ItmsGrpNam\" LIKE '%IRON%' OR T3.\"ItmsGrpNam\" LIKE '%MICROWAVE%' OR T3.\"ItmsGrpNam\" LIKE '%FAN%' OR T3.\"ItmsGrpNam\" LIKE '%VACUUM%' THEN 'SA - Small Appliances' WHEN T3.\"ItmsGrpNam\" LIKE '%BED ROOM%' OR T3.\"ItmsGrpNam\" LIKE '%LVG ROOM%' OR T3.\"ItmsGrpNam\" LIKE '%SOFA%' OR T3.\"ItmsGrpNam\" LIKE '%FURNITURE%' OR T3.\"ItmsGrpNam\" LIKE '%DINING%' THEN 'FURNITURE' ELSE 'OTHER' END AS \"Department\", T3.\"ItmsGrpNam\" AS \"Product Category\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Sales\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T4 ON T1.\"ItemCode\" = T4.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T4.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" LEFT JOIN \"OWHS\" TWH ON T0.\"U_ReqWhs\" = TWH.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEF' AND T4.\"ItemName\" NOT LIKE '%Carry Bag%' AND T4.\"ItemName\" NOT LIKE '%carry bag%' AND T1.\"LineTotal\" > 0 GROUP BY CASE WHEN T3.\"ItmsGrpNam\" LIKE 'MOB-%' OR T3.\"ItmsGrpNam\" LIKE '%MOBILE%' OR T3.\"ItmsGrpNam\" LIKE '%TABLET%' OR T3.\"ItmsGrpNam\" LIKE '%SMART PHONE%' THEN 'DIG - Digital/Mobile' WHEN T3.\"ItmsGrpNam\" LIKE '%REFRIGERATOR%' OR T3.\"ItmsGrpNam\" LIKE '%WASHING%' OR T3.\"ItmsGrpNam\" LIKE '%AIR CONDITIONER%' OR T3.\"ItmsGrpNam\" LIKE '%DISHWASHER%' OR T3.\"ItmsGrpNam\" LIKE 'SAMSUNG REF%' OR T3.\"ItmsGrpNam\" LIKE 'LG REF%' OR T3.\"ItmsGrpNam\" LIKE '%WM%' OR T3.\"ItmsGrpNam\" LIKE '%A/C%' THEN 'HA - Home Appliances' WHEN T3.\"ItmsGrpNam\" LIKE '%PANEL%' OR T3.\"ItmsGrpNam\" LIKE '%TV%' OR T3.\"ItmsGrpNam\" LIKE '%AUDIO%' OR T3.\"ItmsGrpNam\" LIKE '%HOME THEATRE%' THEN 'CE - Consumer Electronics' WHEN T3.\"ItmsGrpNam\" LIKE '%LAP TOP%' OR T3.\"ItmsGrpNam\" LIKE '%LAPTOP%' OR T3.\"ItmsGrpNam\" LIKE '%PRINTER%' OR T3.\"ItmsGrpNam\" LIKE '%DESKTOP%' THEN 'IT - Information Technology' WHEN T3.\"ItmsGrpNam\" LIKE '%WATER PURIFIER%' OR T3.\"ItmsGrpNam\" LIKE '%GAS STOVE%' OR T3.\"ItmsGrpNam\" LIKE '%AIR COOLER%' OR T3.\"ItmsGrpNam\" LIKE '%MIXER%' OR T3.\"ItmsGrpNam\" LIKE '%IRON%' OR T3.\"ItmsGrpNam\" LIKE '%MICROWAVE%' OR T3.\"ItmsGrpNam\" LIKE '%FAN%' OR T3.\"ItmsGrpNam\" LIKE '%VACUUM%' THEN 'SA - Small Appliances' WHEN T3.\"ItmsGrpNam\" LIKE '%BED ROOM%' OR T3.\"ItmsGrpNam\" LIKE '%LVG ROOM%' OR T3.\"ItmsGrpNam\" LIKE '%SOFA%' OR T3.\"ItmsGrpNam\" LIKE '%FURNITURE%' OR T3.\"ItmsGrpNam\" LIKE '%DINING%' THEN 'FURNITURE' ELSE 'OTHER' END, T3.\"ItmsGrpNam\" ORDER BY \"Department\", SUM(T1.\"LineTotal\") DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
{"timestamp": "2026-09-28T09:18:55.089072", "query": "SELECT TOP 25 T3.\"ItmsGrpNam\" AS \"Product Category\", T4.\"ItmsGrpCod\" AS \"CatCode\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Sales\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T4 ON T1.\"ItemCode\" = T4.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T4.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEF' AND T4.\"ItemName\" NOT LIKE '%Carry Bag%' AND T4.\"ItemName\" NOT LIKE '%carry bag%' AND T1.\"LineTotal\" > 0 GROUP BY T3.\"ItmsGrpNam\", T4.\"ItmsGrpCod\" ORDER BY SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T09:19:08.049384", "query": "SELECT TOP 25 T3.\"ItmsGrpNam\" AS \"Brand Category\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Sales\", COUNT(DISTINCT T0.\"DocNum\") AS \"Invoice Count\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T4 ON T1.\"ItemCode\" = T4.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T4.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEF' AND T4.\"ItemName\" NOT LIKE '%Carry Bag%' AND T4.\"ItemName\" NOT LIKE '%carry bag%' AND T1.\"LineTotal\" > 0 AND T3.\"ItmsGrpNam\" IN ( 'MOB-VIVO','MOB-APPLE IPHONE','MOB-OPPO','MOB-ONE PLUS','MOB-SAMSUNG','MOB-XIAOMI','MOB-REALME', 'SONY PANEL','LG PANEL','SAMSUNG PANEL','HAIER PANEL', 'SAMSUNG REFRIGERATOR','WHIRLPOOL REF','LG REFRIGERATOR','HAIER REFRIGERATOR','GODREJ REFRIGERATOR', 'SAMSUNG WM','IFB WM','LG WM','BOSCH WM','WHIRLPOOL WM', 'LG AIR COND','LLOYD AIR COND', 'HP LAP TOP','DELL LAP TOP' ) GROUP BY T3.\"ItmsGrpNam\" ORDER BY SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T09:22:29.754547", "query": "SELECT IFNULL(T2.\"WhsName\", 'Unassigned') AS \"Branch Name\", IFNULL(T2.\"U_Location\", 'Unassigned') AS \"Location\", COUNT(DISTINCT T0.\"DocNum\") AS \"Total Invoices\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Revenue\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" LEFT JOIN \"OWHS\" T2 ON T0.\"U_ReqWhs\" = T2.\"WhsCode\" INNER JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T3.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEFECTIVE' AND T3.\"ItmsGrpCod\" NOT IN (SELECT \"ItmsGrpCod\" FROM \"OITB\" WHERE \"ItmsGrpNam\" LIKE '%Carry Bag%') AND T1.\"ItemCode\" NOT LIKE '%CARRY%BAG%' AND T0.\"DocType\" != 'I' GROUP BY T2.\"WhsName\", T2.\"U_Location\" ORDER BY \"Total Revenue\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T09:22:35.780755", "query": "SELECT IFNULL(T2.\"WhsName\", 'Unassigned') AS \"Branch Name\", IFNULL(T2.\"U_Location\", 'Unassigned') AS \"Location\", COUNT(DISTINCT T0.\"DocNum\") AS \"Total Invoices\", SUM(T1.\"Quantity\") AS \"Total Quantity\", SUM(T1.\"LineTotal\") AS \"Total Revenue\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" LEFT JOIN \"OWHS\" T2 ON T0.\"U_ReqWhs\" = T2.\"WhsCode\" INNER JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN \"OITB\" T4 ON T3.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T1.\"WhsCode\" != 'DEFECTIVE' AND T4.\"ItmsGrpNam\" NOT LIKE '%Carry Bag%' AND T3.\"ItemName\" NOT LIKE '%CARRY BAG%' GROUP BY T2.\"WhsName\", T2.\"U_Location\" ORDER BY \"Total Revenue\" DESC", "status": "SUCCESS", "details": ""}
