{"timestamp": "2026-09-22T09:57:22.521383", "query": "SELECT TOP 50 T2.\"WhsCode\" AS WarehouseCode, T2.\"WhsName\" AS WarehouseName, T2.\"U_Location\" AS BranchLocation, T2.\"U_BranchType\" AS BranchType, SUM(T1.\"LineTotal\") AS TotalSalesValue FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OWHS T2 ON T1.\"WhsCode\" = T2.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T2.\"WhsCode\", T2.\"WhsName\", T2.\"U_Location\", T2.\"U_BranchType\" ORDER BY TotalSalesValue DESC", "status": "SUCCESS", "details": ""}
