{"timestamp": "2026-09-22T09:58:26.063839", "query": "SELECT TOP 50 T1.\"WhsCode\" AS BranchCode, T2.\"WhsName\" AS BranchName, COUNT(DISTINCT T0.\"DocEntry\") AS TotalInvoices, ROUND(SUM(T0.\"DocTotal\"), 2) AS TotalSalesValue, ROUND(SUM(T0.\"DocTotal\") / COUNT(DISTINCT T0.\"DocEntry\"), 2) AS AvgInvoiceValue, ROUND(MAX(T0.\"DocTotal\"), 2) AS MaxInvoiceValue, ROUND(MIN(T0.\"DocTotal\"), 2) AS MinInvoiceValue FROM INV1 T1 INNER JOIN OINV T0 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OWHS T2 ON T1.\"WhsCode\" = T2.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T1.\"WhsCode\", T2.\"WhsName\" ORDER BY ROUND(SUM(T0.\"DocTotal\") / COUNT(DISTINCT T0.\"DocEntry\"), 2) DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:00:14.857103", "query": "SELECT TOP 50 T0.\"CardCode\", T0.\"CardName\", COUNT(DISTINCT T3.\"ItmsGrpCod\") AS \"Distinct_Categories\", STRING_AGG(DISTINCT T3.\"ItmsGrpNam\", ' | ') AS \"Product_Categories\", COUNT(DISTINCT T0.\"DocNum\") AS \"Total_Invoices\", SUM(T1.\"LineTotal\") AS \"Total_Sales_Value\" FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T0.\"CardCode\", T0.\"CardName\" HAVING COUNT(DISTINCT T3.\"ItmsGrpCod\") > 1 ORDER BY COUNT(DISTINCT T3.\"ItmsGrpCod\") DESC, SUM(T1.\"LineTotal\") DESC", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"sql syntax error: incorrect syntax near \\\"DISTINCT\\\": line 1 col 114 (at pos 114)\"}"}
{"timestamp": "2026-09-22T10:00:22.028346", "query": "SELECT TOP 50 T0.\"CardCode\", T0.\"CardName\", COUNT(DISTINCT T3.\"ItmsGrpCod\") AS \"Distinct_Categories\", COUNT(DISTINCT T0.\"DocNum\") AS \"Total_Invoices\", SUM(T1.\"LineTotal\") AS \"Total_Sales_Value\" FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' GROUP BY T0.\"CardCode\", T0.\"CardName\" HAVING COUNT(DISTINCT T3.\"ItmsGrpCod\") > 1 ORDER BY COUNT(DISTINCT T3.\"ItmsGrpCod\") DESC, SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:01:38.327172", "query": "SELECT TOP 50 T3.\"ItmsGrpNam\" AS Category_A, T4.\"ItmsGrpNam\" AS Category_B, COUNT(DISTINCT T0.\"DocNum\") AS Co_Purchase_Count, COUNT(DISTINCT T0.\"CardCode\") AS Shared_Customer_Count FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN INV1 T2 ON T0.\"DocEntry\" = T2.\"DocEntry\" AND T2.\"ItemCode\" <> T1.\"ItemCode\" INNER JOIN OITM IT1 ON T1.\"ItemCode\" = IT1.\"ItemCode\" INNER JOIN OITM IT2 ON T2.\"ItemCode\" = IT2.\"ItemCode\" INNER JOIN OITB T3 ON IT1.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN OITB T4 ON IT2.\"ItmsGrpCod\" = T4.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T3.\"ItmsGrpCod\" < T4.\"ItmsGrpCod\" AND T0.\"CardCode\" NOT IN ('PAI_STO_KA','PAI_STO_AP','PAI_STO_TS','C8904078591','PAI_STO_KA-1') GROUP BY T3.\"ItmsGrpNam\", T4.\"ItmsGrpNam\" ORDER BY Co_Purchase_Count DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-22T10:02:48.792628", "query": "SELECT TOP 50 CASE WHEN OG.ItmsGrpNam LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.ItmsGrpNam LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.ItmsGrpNam LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.ItmsGrpNam LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.ItmsGrpNam LIKE 'MOB-APPLE%' THEN 'APPLE' END AS MobileBrand, COUNT(DISTINCT T0.\"DocEntry\") AS TotalPhoneInvoices, COUNT(DISTINCT T0.\"CardCode\") AS UniqueCustomers FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB OG ON T2.\"ItmsGrpCod\" = OG.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND OG.ItmsGrpNam IN ( SELECT ItmsGrpNam FROM OITB WHERE ItmsGrpNam LIKE 'MOB-VIVO%' OR ItmsGrpNam LIKE 'MOB-OPPO%' OR ItmsGrpNam LIKE 'MOB-XIAOMI%' OR ItmsGrpNam LIKE 'MOB-SAMSUNG%' OR ItmsGrpNam LIKE 'MOB-APPLE%' ) GROUP BY CASE WHEN OG.ItmsGrpNam LIKE 'MOB-VIVO%' THEN 'VIVO' WHEN OG.ItmsGrpNam LIKE 'MOB-OPPO%' THEN 'OPPO' WHEN OG.ItmsGrpNam LIKE 'MOB-XIAOMI%' THEN 'XIAOMI' WHEN OG.ItmsGrpNam LIKE 'MOB-SAMSUNG%' THEN 'SAMSUNG' WHEN OG.ItmsGrpNam LIKE 'MOB-APPLE%' THEN 'APPLE' END", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"invalid column name: ITMSGRPNAM: line 1 col 623 (at pos 622)\"}"}
