{"timestamp": "2026-09-28T15:43:55.626624", "query": "SELECT TOP 50 T0.\"ItemCode\" AS \"Item Code\", T0.\"ItemName\" AS \"Item Name\", T2.\"ItmsGrpNam\" AS \"Category\", T1.\"WhsCode\" AS \"Warehouse Code\", T3.\"WhsName\" AS \"Warehouse Name\", T3.\"Location\" AS \"Location\", T1.\"OnHand\" AS \"On Hand Qty\", T1.\"IsCommited\" AS \"Committed Qty\", T1.\"OnOrder\" AS \"On Order Qty\", (T1.\"OnHand\" - T1.\"IsCommited\") AS \"Available Qty\", T0.\"MinLevel\" AS \"Min Stock Level\", T0.\"ReorderPnt\" AS \"Reorder Point\", T0.\"LastPurPrc\" AS \"Last Purchase Price\" FROM \"OITM\" T0 INNER JOIN \"OITW\" T1 ON T0.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OITB\" T2 ON T0.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" INNER JOIN \"OWHS\" T3 ON T1.\"WhsCode\" = T3.\"WhsCode\" WHERE T0.\"InvntItem\" = 'Y' AND T0.\"Canceled\" = 'N' AND T0.\"validFor\" = 'Y' AND T1.\"OnHand\" > 0 AND T1.\"OnHand\" < T0.\"MinLevel\" AND T0.\"MinLevel\" > 0 AND T3.\"WhsName\" NOT LIKE '%defect%' AND T3.\"WhsName\" NOT LIKE '%Defect%' AND T0.\"ItemName\" NOT LIKE '%Carry Bag%' AND T0.\"ItemName\" NOT LIKE '%carry bag%' ORDER BY (T0.\"MinLevel\" - T1.\"OnHand\") DESC, T1.\"OnHand\" ASC", "status": "SUCCESS", "details": ""}
