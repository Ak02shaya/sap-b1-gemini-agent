{"timestamp": "2026-09-28T16:22:49.102620", "query": "SELECT TOP 25 T3.\"U_SubCategory\" AS Category, T2.\"ItmsGrpNam\" AS Brand, COUNT(DISTINCT T0.\"DocEntry\") AS Invoices, SUM(T1.\"Quantity\") AS TotalQty, SUM(T1.\"LineTotal\") AS TotalRevenue, RANK() OVER (PARTITION BY T3.\"U_SubCategory\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS RevenueRank FROM \"OINV\" T0 JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" JOIN \"OITB\" T2 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T3.\"U_SubCategory\" = 'MULTI' AND UPPER(T3.\"ItemName\") NOT LIKE '%CARRY BAG%' AND T1.\"WhsCode\" NOT IN (SELECT \"WhsCode\" FROM \"OWHS\" WHERE UPPER(\"WhsName\") LIKE '%DEFECT%') GROUP BY T3.\"U_SubCategory\", T2.\"ItmsGrpNam\" ORDER BY TotalRevenue DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T16:22:58.215707", "query": "SELECT TOP 25 INNER_Q.\"Category\", INNER_Q.\"Brand\", INNER_Q.\"Invoices\", INNER_Q.\"TotalQty\", INNER_Q.\"TotalRevenue\", INNER_Q.\"RevenueRank\" FROM ( SELECT T3.\"U_SubCategory\" AS \"Category\", T2.\"ItmsGrpNam\" AS \"Brand\", COUNT(DISTINCT T0.\"DocEntry\") AS \"Invoices\", SUM(T1.\"Quantity\") AS \"TotalQty\", SUM(T1.\"LineTotal\") AS \"TotalRevenue\", RANK() OVER (PARTITION BY T3.\"U_SubCategory\" ORDER BY SUM(T1.\"LineTotal\") DESC) AS \"RevenueRank\", RANK() OVER (PARTITION BY T3.\"U_SubCategory\" ORDER BY SUM(T1.\"Quantity\") DESC) AS \"QtyRank\" FROM \"OINV\" T0 JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" JOIN \"OITB\" T2 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T3.\"U_SubCategory\" IS NOT NULL AND UPPER(T3.\"ItemName\") NOT LIKE '%CARRY BAG%' AND T1.\"WhsCode\" NOT IN (SELECT \"WhsCode\" FROM \"OWHS\" WHERE UPPER(\"WhsName\") LIKE '%DEFECT%') GROUP BY T3.\"U_SubCategory\", T2.\"ItmsGrpNam\" ) INNER_Q WHERE INNER_Q.\"RevenueRank\" <= 3 ORDER BY INNER_Q.\"Category\", INNER_Q.\"RevenueRank\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-28T16:23:05.488448", "query": "SELECT DISTINCT T3.\"U_HC\", T3.\"U_SubCategory\", T2.\"ItmsGrpNam\" FROM \"OITM\" T3 JOIN \"OITB\" T2 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T3.\"U_SubCategory\" = 'MULTI' ORDER BY T3.\"U_HC\" LIMIT 30", "status": "SUCCESS", "details": ""}
