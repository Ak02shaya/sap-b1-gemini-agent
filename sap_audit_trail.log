{"timestamp": "2026-09-28T15:15:30.698499", "query": "SELECT TOP 50 OWHS.\"WhsName\" AS \"Branch Name\", OWHS.\"Location\" AS \"City / Location\", OWHS.\"U_Location\" AS \"Branch Location\", COUNT(DISTINCT T0.\"DocEntry\") AS \"No. of Invoices\", SUM(T1.\"LineTotal\") AS \"Total Revenue (INR)\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OWHS\" OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND OWHS.\"WhsName\" NOT LIKE '%defect%' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND T1.\"ItemCode\" NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY OWHS.\"WhsName\", OWHS.\"Location\", OWHS.\"U_Location\" ORDER BY SUM(T1.\"LineTotal\") DESC", "status": "SUCCESS", "details": ""}
