{"timestamp": "2026-09-26T15:36:28.280568", "query": "SELECT TOP 25 IFNULL(T5.\"WhsCode\", 'Unassigned') AS \"Branch\", IFNULL(T5.\"U_Location\", 'Unassigned') AS \"Location\", IFNULL(T5.\"U_BranchType\", 'Unassigned') AS \"BranchType\", COUNT(DISTINCT T0.\"DocEntry\") AS \"InvoiceCount\", ROUND(SUM(T1.\"Quantity\"), 2) AS \"TotalQtySold\", ROUND(SUM(T1.\"LineTotal\"), 2) AS \"TotalSalesAmount\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" LEFT JOIN \"OWHS\" T5 ON T0.\"U_ReqWhs\" = T5.\"WhsCode\" WHERE T4.\"FirmName\" LIKE '%Samsung%' AND T2.\"ItemName\" LIKE '%Panel%' AND T0.\"U_ReqWhs\" NOT LIKE 'CWH%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T2.\"ItemName\" NOT LIKE '%Carry Bag%' AND YEAR(T0.\"DocDate\") = (SELECT YEAR(MAX(\"DocDate\")) FROM \"OINV\") GROUP BY T5.\"WhsCode\", T5.\"U_Location\", T5.\"U_BranchType\" ORDER BY \"TotalSalesAmount\" DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-26T15:36:33.301861", "query": "SELECT TOP 25 T4.\"FirmName\" AS \"Brand\", T3.\"ItmsGrpNam\" AS \"ItemGroup\", T2.\"ItemName\" AS \"SampleItem\" FROM \"OITM\" T2 INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" WHERE T4.\"FirmName\" LIKE '%Samsung%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' GROUP BY T4.\"FirmName\", T3.\"ItmsGrpNam\", T2.\"ItemName\" ORDER BY T3.\"ItmsGrpNam\"", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-26T15:36:36.596910", "query": "SELECT TOP 25 T4.\"FirmName\" AS \"Brand\", T3.\"ItmsGrpNam\" AS \"ItemGroup\", T2.\"ItemName\" AS \"SampleItem\" FROM \"OITM\" T2 INNER JOIN \"OITB\" T3 ON T2.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OMRC\" T4 ON T2.\"FirmCode\" = T4.\"FirmCode\" WHERE UPPER(T4.\"FirmName\") LIKE '%SAMSUNG%' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' ORDER BY T3.\"ItmsGrpNam\"", "status": "SUCCESS", "details": ""}
