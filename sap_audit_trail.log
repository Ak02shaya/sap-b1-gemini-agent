{"timestamp": "2026-09-28T16:18:27.600522", "query": "SELECT T2.\"ItmsGrpNam\" AS \"Brand_Category\", COUNT(DISTINCT T1.\"DocEntry\") AS \"Invoice_Count\", SUM(T1.\"Quantity\") AS \"Total_Qty_Sold\", SUM(T1.\"LineTotal\") AS \"Total_Revenue\", ROUND(SUM(T1.\"LineTotal\") * 100.0 / SUM(SUM(T1.\"LineTotal\")) OVER (), 2) AS \"Revenue_Share_Pct\" FROM \"OINV\" T0 INNER JOIN \"INV1\" T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN \"OITM\" T3 ON T1.\"ItemCode\" = T3.\"ItemCode\" INNER JOIN \"OITB\" T2 ON T3.\"ItmsGrpCod\" = T2.\"ItmsGrpCod\" WHERE T0.\"CANCELED\" = 'N' AND T3.\"U_SubCategory\" IN ('MULTI', 'MULTI UTILITY') AND UPPER(T2.\"ItmsGrpNam\") NOT LIKE '%CARRY BAG%' GROUP BY T2.\"ItmsGrpNam\" ORDER BY \"Total_Revenue\" DESC", "status": "SUCCESS", "details": ""}
