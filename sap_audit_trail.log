{"timestamp": "2026-09-29T03:08:17.350605", "query": "SELECT TOP 25 OWHS.\"WhsCode\" AS \"WarehouseCode\", OWHS.\"WhsName\" AS \"WarehouseName\", OWHS.\"U_Location\" AS \"Location\", OITB.\"ItmsGrpNam\" AS \"ProductCategory\", SUM(OITW.\"OnHand\") AS \"StockQty\", SUM(OITW.\"OnHand\" * OITM.\"AvgPrice\") AS \"StockValue\" FROM \"OITW\" OITW JOIN \"OITM\" OITM ON OITW.\"ItemCode\" = OITM.\"ItemCode\" JOIN \"OITB\" OITB ON OITM.\"ItmsGrpCod\" = OITB.\"ItmsGrpCod\" JOIN \"OWHS\" OWHS ON OITW.\"WhsCode\" = OWHS.\"WhsCode\" WHERE OITW.\"OnHand\" > 0 AND OITM.\"ItemName\" NOT LIKE '%Carry Bag%' AND OITM.\"ItemName\" NOT LIKE '%PAI Carry Bag%' AND OITW.\"U_DefStock\" <> 'Y' AND OWHS.\"WhsName\" NOT LIKE '%Defect%' AND OWHS.\"WhsName\" NOT LIKE '%defect%' GROUP BY OWHS.\"WhsCode\", OWHS.\"WhsName\", OWHS.\"U_Location\", OITB.\"ItmsGrpNam\" ORDER BY OWHS.\"WhsName\", SUM(OITW.\"OnHand\" * OITM.\"AvgPrice\") DESC", "status": "API_ERROR", "details": "VZone API Error: 403 - {\"status\":403,\"message\":\"invalid number: Failed to parse constant Y\"}"}
