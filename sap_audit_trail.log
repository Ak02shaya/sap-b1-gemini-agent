{"timestamp": "2026-09-29T16:14:31.203367", "company_id": "PAI_LIVE_1", "query": "SELECT TOP 25 OITB.\"ItmsGrpNam\" AS Category, SUM(T1.\"LineTotal\") AS SalesValue, SUM(T1.\"Quantity\") AS QuantitySold, COUNT(DISTINCT T0.\"DocNum\") AS NumberOfInvoices FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB ON T2.\"ItmsGrpCod\" = OITB.\"ItmsGrpCod\" INNER JOIN OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND LOWER(OWHS.\"WhsName\") NOT LIKE '%defect%' AND T1.\"TreeType\" <> 'S' AND LOWER(T1.\"ItemCode\") NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY OITB.\"ItmsGrpNam\" ORDER BY SalesValue DESC", "status": "SUCCESS", "details": ""}
{"timestamp": "2026-09-29T16:15:05.786362", "company_id": "PAI_LIVE_1", "query": "SELECT TOP 25 CASE WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%VIVO%' THEN 'VIVO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%APPLE%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%IPHONE%' THEN 'APPLE' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%OPPO%' THEN 'OPPO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%SAMSUNG%' THEN 'SAMSUNG' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%XIAOMI%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%MI %' THEN 'XIAOMI' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%ONE PLUS%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%ONEPLUS%' THEN 'OnePlus' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LG%' THEN 'LG' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%SONY%' THEN 'SONY' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%HP%' THEN 'HP' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%DELL%' THEN 'DELL' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LENOVO%' THEN 'LENOVO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%WHIRLPOOL%' THEN 'WHIRLPOOL' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%IFB%' THEN 'IFB' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%BOSCH%' THEN 'BOSCH' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%HAIER%' THEN 'HAIER' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%GODREJ%' THEN 'GODREJ' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LLOYD%' THEN 'LLOYD' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%DAIKIN%' THEN 'DAIKIN' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%VOLTAS%' THEN 'VOLTAS' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%PANASONIC%' THEN 'PANASONIC' ELSE 'OTHER' END AS Brand, CASE WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%MOB%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%PHONE%' THEN 'Mobile Phones' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%PANEL%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%TV%' THEN 'Televisions' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LAP TOP%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%LAPTOP%' THEN 'Laptops' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%REF%' THEN 'Refrigerators' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%WM%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%WASHING%' THEN 'Washing Machines' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%AIR COND%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%AC%' THEN 'Air Conditioners' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%MICRO%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%OVEN%' THEN 'Microwave Ovens' ELSE 'Other Products' END AS ProductCategory, SUM(T1.\"LineTotal\") AS SalesValue, SUM(T1.\"Quantity\") AS QuantitySold, COUNT(DISTINCT T0.\"DocNum\") AS NumberOfInvoices FROM OINV T0 INNER JOIN INV1 T1 ON T0.\"DocEntry\" = T1.\"DocEntry\" INNER JOIN OITM T2 ON T1.\"ItemCode\" = T2.\"ItemCode\" INNER JOIN OITB ON T2.\"ItmsGrpCod\" = OITB.\"ItmsGrpCod\" INNER JOIN OWHS ON T1.\"WhsCode\" = OWHS.\"WhsCode\" WHERE T0.\"CANCELED\" = 'N' AND T0.\"DocType\" = 'I' AND LOWER(OWHS.\"WhsName\") NOT LIKE '%defect%' AND T1.\"TreeType\" <> 'S' AND LOWER(T1.\"ItemCode\") NOT LIKE '%carry%' AND LOWER(T1.\"Dscription\") NOT LIKE '%carry bag%' GROUP BY CASE WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%VIVO%' THEN 'VIVO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%APPLE%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%IPHONE%' THEN 'APPLE' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%OPPO%' THEN 'OPPO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%SAMSUNG%' THEN 'SAMSUNG' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%XIAOMI%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%MI %' THEN 'XIAOMI' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%ONE PLUS%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%ONEPLUS%' THEN 'OnePlus' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LG%' THEN 'LG' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%SONY%' THEN 'SONY' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%HP%' THEN 'HP' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%DELL%' THEN 'DELL' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LENOVO%' THEN 'LENOVO' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%WHIRLPOOL%' THEN 'WHIRLPOOL' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%IFB%' THEN 'IFB' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%BOSCH%' THEN 'BOSCH' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%HAIER%' THEN 'HAIER' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%GODREJ%' THEN 'GODREJ' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LLOYD%' THEN 'LLOYD' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%DAIKIN%' THEN 'DAIKIN' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%VOLTAS%' THEN 'VOLTAS' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%PANASONIC%' THEN 'PANASONIC' ELSE 'OTHER' END, CASE WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%MOB%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%PHONE%' THEN 'Mobile Phones' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%PANEL%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%TV%' THEN 'Televisions' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%LAP TOP%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%LAPTOP%' THEN 'Laptops' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%REFRIGERATOR%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%REF%' THEN 'Refrigerators' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%WM%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%WASHING%' THEN 'Washing Machines' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%AIR COND%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%AC%' THEN 'Air Conditioners' WHEN UPPER(OITB.\"ItmsGrpNam\") LIKE '%MICRO%' OR UPPER(OITB.\"ItmsGrpNam\") LIKE '%OVEN%' THEN 'Microwave Ovens' ELSE 'Other Products' END ORDER BY SalesValue DESC", "status": "API_ERROR", "details": "VZone API Error: 404 - <!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Strict//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd\">\r\n<html xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\"/>\r\n<title>404 - File or directory not found.</title>\r\n<style type=\"text/css\">\r\n<!--\r\nbody{margin:0;font-size:.7em;font-family:Verdana, Arial, Helvetica, sans-serif;background:#EEEEEE;}\r\nfieldset{padding:0 15px 10px 15px;} \r\nh1{font-size:2.4em;margin:0;color:#FFF;}\r\nh2{font-size:1.7em;margin:0;color:#CC0000;} \r\nh3{font-size:1.2em;margin:10px 0 0 0;color:#000000;} \r\n#header{width:96%;margin:0 0 0 0;padding:6px 2% 6px 2%;font-family:\"trebuchet MS\", Verdana, sans-serif;color:#FFF;\r\nbackground-color:#555555;}\r\n#content{margin:0 0 0 2%;position:relative;}\r\n.content-container{background:#FFF;width:96%;margin-top:8px;padding:10px;position:relative;}\r\n-->\r\n</style>\r\n</head>\r\n<body>\r\n<div id=\"header\"><h1>Server Error</h1></div>\r\n<div id=\"content\">\r\n <div class=\"content-container\"><fieldset>\r\n  <h2>404 - File or directory not found.</h2>\r\n  <h3>The resource you are looking for might have been removed, had its name changed, or is temporarily unavailable.</h3>\r\n </fieldset></div>\r\n</div>\r\n</body>\r\n</html>\r\n"}
