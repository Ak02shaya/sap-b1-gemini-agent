{"timestamp": "2026-09-28T03:44:31.077639", "query": "SELECT TOP 25 T0.\"ItemCode\", T0.\"ItemName\", T1.\"WhsCode\", T2.\"WhsName\", T1.\"OnHand\", T1.\"IsCommited\", T1.\"OnOrder\", (T1.\"OnHand\" - T1.\"IsCommited\") AS \"AvailableStock\", T3.\"ItmsGrpNam\" AS \"Category\", T4.\"FirmName\" AS \"Brand\", T0.\"MinLevel\" FROM \"OITM\" T0 INNER JOIN \"OITW\" T1 ON T0.\"ItemCode\" = T1.\"ItemCode\" INNER JOIN \"OWHS\" T2 ON T1.\"WhsCode\" = T2.\"WhsCode\" INNER JOIN \"OITB\" T3 ON T0.\"ItmsGrpCod\" = T3.\"ItmsGrpCod\" INNER JOIN \"OMRC\" T4 ON T0.\"FirmCode\" = T4.\"FirmCode\" WHERE T1.\"OnHand\" > 0 AND T1.\"OnHand\" <= 10 AND T0.\"SellItem\" = 'Y' AND T3.\"ItmsGrpNam\" NOT LIKE '%Defective%' AND T0.\"ItemName\" NOT LIKE '%Carry Bag%' AND T2.\"WhsCode\" NOT LIKE 'CWH%' ORDER BY T1.\"OnHand\" ASC, T0.\"ItemCode\"", "status": "SUCCESS", "details": ""}
